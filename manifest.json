{
  "manifest_version": 3,
  "name": "YouTube Auto Suscriptor",
  "description": "Extensión para suscribirse automáticamente a canales de YouTube desde una lista de URLs",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Abrir el popup"
    },
    "open_full_page": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      },
      "description": "Abrir la página completa"
    }
  },
  "options_page": "index.html"
}
